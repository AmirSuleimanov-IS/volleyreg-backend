      "name": "3. Вход представителя команды",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('creatorToken', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"sever_rep\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "4. Представитель: список заявок — только свои",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('статус 200', () => pm.response.to.have.status(200));",
              "pm.test('только заявки sever_rep', () => pm.response.json().forEach(a => pm.expect(a.creator_login).to.eql('sever_rep')));"
            ]
